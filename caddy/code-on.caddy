# The Code page on (./stack code enable; compose.code.yaml sets CODE_MODE=on). Imported by Caddyfile; the snippets
# (code_unlock, code_auth, code_portal, code_upstream, code_page) are defined there. The code container shares only the
# code-link network with this Caddy (code-upstream:8095) and requires the secret header added here.

# code.PORTAL_HOST (CODE_HOST): the Code page, framed by the portal's Code tab — or full screen on a phone.
http://{$CODE_HOST} {
	route {
		import local_request
		import not_from_preview
		import code_unlock
		import code_auth
		import code_portal
		reverse_proxy code-upstream:8095 {
			import code_upstream {$PORTAL_ORIGIN} {$TERMINAL_HOST} 0
			import code_page {$PORTAL_ORIGIN} {$TERMINAL_HOST} http://*.{$PREVIEW_DOMAIN:preview.invalid}:{$PORTAL_PORT:80}
		}
	}
}

# Your subscriptions as Chat models (code/server/chat.mjs): Open WebUI's connection to the code container goes through
# this site, so the code container shares no network with Open WebUI — which signs in by X-Portal-User from any peer —
# a one-way hop, as the stt site's. Port 8098 is not published; it answers on Caddy's container networks. Two paths
# only; nothing that only Caddy, the portal or the sidecar may set is passed on, and no secret is added: the chat
# server requires CODE_CHAT_KEY itself. A request of at most 24 MB (the whole conversation, with its images).
http://:8098 {
	route {
		request_header -X-Portal-User
		request_header -X-Portal-Remote
		request_header -X-Portal-Proxy
		request_header -X-Bn-Code-Proxy
		request_header -Tailscale-User-Login
		request_header -Tailscale-User-Name
		request_header -Tailscale-User-Profile-Pic
		request_header -Tailscale-Headers-Info
		request_header -Cookie
		request_body {
			max_size 24MB
		}
		@chat path /v1/models /v1/chat/completions
		reverse_proxy @chat code-upstream:8096 {
			flush_interval -1
		}
		respond 404
	}
}
