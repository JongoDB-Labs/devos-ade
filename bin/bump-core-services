#!/usr/bin/env python3
"""bump-core-services: the maintainer's tool that brings every pinned core service to its newest TESTED release.

For maintainers, run from a checkout before each DevOS ADE release (docs/releasing.md); never on a user's computer
(./stack update only pulls what a release already pins). It does not run anything of the stack.

For every pin it finds the newest stable upstream release that is past a COOLDOWN (at least 3 days old, so a release
that is pulled within days never gets pinned), unless a maintainer names its security advisory with --allow-security (checked against the GitHub Advisory Database;
release-note text alone never skips the cooldown, it is only reported). Then it resolves the image DIGEST, rewrites the pins in place and prints an old -> new table with release-note
links:

  compose.yaml, open-webui/Dockerfile, caddy/Dockerfile      LiteLLM, Open WebUI, RustFS, Caddy, pgvector, SearXNG, aws-cli
  portal/, shared-mcp/, stt/, code/, terminal/ Dockerfiles   the python / node / alpine base images (tag kept, digest moved)
  terminal/Dockerfile ARGs                                   Codex, Copilot CLI, ttyd, gh (versions + SHA-256 of the files)
  */requirements.txt                                         the pip locks, re-locked with hashes (uv pip compile)
  catalog/core-services.tsv                                  what ./stack versions and Settings show as "newest upstream"

  bin/bump-core-services            bump everything
  bin/bump-core-services --check    only report (exit 0: up to date, 3: something to bump); changes no file
  bin/bump-core-services --only litellm,gh     only these targets (names in the table)
  bin/bump-core-services --now 2026-10-27T12:00:00Z    the clock the cooldown counts from (default: now)

Python 3 standard library only. GITHUB_TOKEN (optional) raises GitHub's API rate limit.
"""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import http.client
import json
import os
import re
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

COOLDOWN_DAYS = 3
REPUSH_DAYS = 1   # an image built this long after its release was pushed again since (not the release's own publishing)
SECURITY_RX = re.compile(r"\bCVE-\d{4}-\d+|\bGHSA-[0-9a-z]{4}-|security (fix|patch|advisory|update|vulnerab)|vulnerabilit|"
                         r"\bsecurity\b.{0,40}\b(fix|patch)", re.I)
DIGEST_RX = r"@sha256:[0-9a-f]{64}"
ACCEPT = ", ".join(["application/vnd.oci.image.index.v1+json", "application/vnd.docker.distribution.manifest.list.v2+json",
                    "application/vnd.oci.image.manifest.v1+json", "application/vnd.docker.distribution.manifest.v2+json"])


# ------------------------------------------------------------------------------------------------------ network
TOKEN_SERVICES = {"auth.docker.io"}   # Docker Hub's token service (ghcr.io answers on its own host)


def https_host(url: str) -> str:
    """The host of an https URL without a user part, lowercased; '' for anything else."""
    try:
        u = urllib.parse.urlsplit(url)
        host = u.hostname
    except ValueError:
        return ""
    return (host or "").lower() if u.scheme == "https" and u.username is None and u.password is None else ""


class Net:
    """The only place that touches the network (tests replace it with a fake that has the same four methods)."""

    def __init__(self, timeout: int = 60):
        self.timeout = timeout
        self._tokens: dict = {}   # (registry, name) -> the registry's Authorization value

    def _open(self, url: str, headers: dict | None = None, method: str = "GET", auth: str = ""):
        req = urllib.request.Request(url, headers=headers or {}, method=method)
        if auth:   # never carried to where a redirect points (a registry's blob store, a renamed repo's new address)
            req.add_unredirected_header("Authorization", auth)
        return urllib.request.urlopen(req, timeout=self.timeout)

    @staticmethod
    def retrying(fn, tries: int = 4):
        """fn(), again after a dropped connection or a timeout (4xx answers are real answers: not retried)."""
        for i in range(tries):
            try:
                return fn()
            except urllib.error.HTTPError:
                raise
            except (urllib.error.URLError, http.client.HTTPException, TimeoutError, ConnectionError):
                if i == tries - 1:
                    raise
                time.sleep(2 * (i + 1))

    def json(self, url: str):
        h = {"Accept": "application/json", "User-Agent": "devos-ade-bump"}
        # GITHUB_TOKEN only for GitHub's API itself: a URL that merely mentions it (a registry's sign-in address,
        # Docker Hub's next page) never gets it
        auth = "Bearer " + os.environ["GITHUB_TOKEN"] if https_host(url) == "api.github.com" and os.environ.get("GITHUB_TOKEN") else ""

        def go():
            with self._open(url, h, auth=auth) as r:
                return json.load(r)
        return self.retrying(go)

    def sha256(self, url: str) -> str:
        def go():
            h = hashlib.sha256()
            with self._open(url, {"User-Agent": "devos-ade-bump"}) as r:
                for chunk in iter(lambda: r.read(1 << 20), b""):
                    h.update(chunk)
            return h.hexdigest()
        return self.retrying(go)

    def _registry(self, registry: str, name: str, path: str, accept: str, method: str = "GET"):
        """registry/v2/name/PATH, signing in by the registry's token challenge when it asks — only at an https address
        on the registry itself or a known token service (a challenge can name any URL)."""
        url = f"https://{registry}/v2/{name}/{path}"
        hdrs = {"Accept": accept, "User-Agent": "devos-ade-bump"}
        tok = self._tokens.get((registry, name), "")
        try:
            return self._open(url, hdrs, method, auth=tok)
        except urllib.error.HTTPError as e:
            if e.code != 401:   # (401 with a kept token: it expired, sign in again)
                raise
            ch = e.headers.get("WWW-Authenticate", "")
            realm = re.search(r'realm="([^"]+)"', ch)
            if not realm:
                raise
            if https_host(realm.group(1)) not in {registry, *TOKEN_SERVICES}:
                raise ValueError(f"{registry} asked to sign in at {realm.group(1)!r}: not https on the registry or a known token service") from None
            q = "&".join(f"{k}={v}" for k, v in re.findall(r'(service|scope)="([^"]+)"', ch))
            t = self.json(realm.group(1) + ("?" + q if q else ""))
            tok = "Bearer " + (t.get("token") or t.get("access_token") or "")
            self._tokens[(registry, name)] = tok
            return self._open(url, hdrs, method, auth=tok)

    def digest(self, registry: str, name: str, tag: str) -> str:
        """The digest of registry/name:tag (the multi-arch index, as `docker pull` pins it), via the registry API."""
        with self._registry(registry, name, f"manifests/{tag}", ACCEPT, "HEAD") as r:
            return r.headers["Docker-Content-Digest"]

    def built(self, registry: str, name: str, digest: str) -> dt.datetime | None:
        """When the image behind DIGEST was built: its linux/amd64 (else first linux) config's `created`; None when it
        does not say."""
        def get(path, accept):
            def go():
                with self._registry(registry, name, path, accept) as r:
                    return json.load(r)
            return self.retrying(go)
        m = get(f"manifests/{digest}", ACCEPT)
        if m.get("manifests"):   # an index: one platform's manifest (attestations say os "unknown")
            linux = [x for x in m["manifests"] if (x.get("platform") or {}).get("os") == "linux"]
            one = next((x for x in linux if x["platform"].get("architecture") == "amd64"), linux[0] if linux else None)
            if not one:
                return None
            m = get(f"manifests/{one['digest']}", ACCEPT)
        cfg = (m.get("config") or {}).get("digest")
        if not cfg:
            return None
        when = get(f"blobs/{cfg}", "application/vnd.oci.image.config.v1+json, application/json, */*").get("created")
        try:
            return parse_time(when) if when else None
        except ValueError:
            return None


# ------------------------------------------------------------------------------------------------------ helpers
def parse_time(s: str) -> dt.datetime:
    s = re.sub(r"(\.\d{6})\d+", r"\1", s.strip().replace("Z", "+00:00"))   # (an image's created: nanoseconds)
    d = dt.datetime.fromisoformat(s if "T" in s or " " in s else s + "T00:00:00+00:00")
    return d if d.tzinfo else d.replace(tzinfo=dt.timezone.utc)


def vkey(v: str) -> tuple:
    return tuple(int(x) for x in re.findall(r"\d+", v))


def age_days(then: dt.datetime, now: dt.datetime) -> float:
    return (now - then).total_seconds() / 86400


def registry_of(repo: str) -> tuple[str, str]:
    """('ghcr.io', 'berriai/litellm') / ('registry-1.docker.io', 'library/caddy')."""
    first = repo.split("/")[0]
    if "." in first:
        return first, repo[len(first) + 1:]
    return "registry-1.docker.io", repo if "/" in repo else "library/" + repo


def hub_repo(repo: str) -> str:
    return repo if "/" in repo else "library/" + repo


class Candidate:
    """One upstream release of a target: its version, when it came out, its notes page and notes text."""

    def __init__(self, version, released, url="", notes=""):
        self.version, self.released, self.url, self.notes = version, released, url, notes

    def security(self) -> str:
        """The words of the notes that make this a security fix ('' when none)."""
        m = SECURITY_RX.search(self.notes or "")
        return m.group(0) if m else ""


def pick(cands: list[Candidate], current: str, now: dt.datetime, cooldown: int = COOLDOWN_DAYS, patched=None, embargo=None):
    """(chosen, newest, why) from stable releases. chosen: the newest at least COOLDOWN days old (never older than
    CURRENT: no downgrade). Release-note text NEVER skips the cooldown (a compromised upstream can write anything in
    its notes): a release that says "security fix" is only REPORTED ("REVIEW: ..."). The one bypass is PATCHED = (version,
    advisory id) of an advisory the maintainer named with --allow-security and that the GitHub Advisory Database
    confirms for this very repo: then the OLDEST release at or past the patched version is taken (the smallest step
    that fixes it) when nothing past the cooldown is. newest: the newest of all. why: '' | 'security fix: ...' |
    'REVIEW: ...' | 'held back: newest X is Nd old' (joined with '; ')."""
    if not cands:
        return None, None, ""
    cands = sorted(cands, key=lambda c: vkey(c.version), reverse=True)
    newest = cands[0]
    chosen, notes = None, []
    for c in cands:
        if vkey(c.version) < vkey(current):
            break
        if age_days(c.released, now) >= cooldown:
            chosen = c
            break
    bypassed = False
    if embargo is not None and vkey(embargo.version) >= vkey(current):   # validated by Allow.embargoed(); a maintainer's override
        chosen, bypassed = embargo, True
        notes.append("security override: advisory pending (--allow-security-embargoed)")
    elif patched:
        pv, aid = patched
        if chosen is None or vkey(chosen.version) < vkey(pv):
            fix = [c for c in cands if vkey(c.version) >= max(vkey(pv), vkey(current))]
            if fix:
                chosen, bypassed = min(fix, key=lambda c: vkey(c.version)), True
                notes.append(f"security fix: {aid} is patched in {pv}; cooldown skipped (--allow-security)")
            else:
                notes.append(f"{aid} is patched in {pv}, but no release at or past it exists yet")
    if chosen is None:  # nothing past the cooldown is newer than what is pinned
        chosen = next((c for c in cands if c.version == current), None) or Candidate(current, newest.released, newest.url)
    if not bypassed:
        for c in cands:   # newer than the pick, and its own notes call it a security fix
            if vkey(c.version) > vkey(chosen.version) and c.security():
                notes.insert(0, f"REVIEW: upstream says security fix in {c.version} (\"{c.security()}\"): review it, then re-run "
                                f"with --allow-security <GHSA or CVE id>")
                break
    if chosen is not newest and not bypassed:
        notes.append(f"held back: {newest.version} is {int(age_days(newest.released, now))}d old (cooldown {cooldown}d)")
    return chosen, newest, "; ".join(notes)


class Refused(Exception):
    """A maintainer's --allow-security... request that the tool refuses (nothing skips the cooldown)."""


class Allow:
    """The maintainer's --allow-security IDS (GHSA-... or CVE-...), each checked against the GitHub Advisory Database
    (never the release notes): the advisory must be for the repo of the target, and gives the patched version."""

    def __init__(self, ids, net, embargo=None, reason=""):
        self.ids, self.net = list(ids), net
        self.advs: dict = {}       # id -> [advisory dicts] | error text
        self.matched: dict = {}    # id -> repo it was confirmed for
        self.embargo, self.reason = dict(embargo or {}), (reason or "").strip()   # service -> version (no leading v)
        self.used: dict = {}       # service -> Candidate, the embargoed overrides this run applied

    def embargoed(self, target, cands, current):
        """The Candidate of an --allow-security-embargoed override for TARGET (an ImageTarget), or None when none was
        asked for it. Raises Refused unless: a reason was given; the release is an official, stable release of the
        canonical GitHub repo (the one of the image's own org: never a fork) that is not older than the pin; and its notes
        say it contains security fixes. The image digest then comes from the official registry like every pin."""
        want = self.embargo.get(target.name)
        if want is None:
            return None
        who = f"--allow-security-embargoed {target.name}={want}"
        if not self.reason:
            raise Refused(f"{who} refused: --reason \"...\" is required (why this release skips the cooldown)")
        src = target.source
        if not isinstance(src, GithubReleases):
            raise Refused(f"{who} refused: {target.name} has no GitHub releases to confirm the security statement in")
        org = target.images[0][0].split("/")[-2].lower() if "/" in target.images[0][0] else ""
        if src.repo.split("/")[0].lower() != org:
            raise Refused(f"{who} refused: {src.repo} is not the canonical repository of the {org or '?'} image")
        c = next((x for x in cands if x.version == want), None)
        if c is None:
            raise Refused(f"{who} refused: {want} is not a stable release of {src.repo}")
        if vkey(c.version) < vkey(current):
            raise Refused(f"{who} refused: the pin is already newer ({current})")
        if not c.security():
            raise Refused(f"{who} refused: the release notes of {c.version} contain no security statement")
        self.used[target.name] = c
        return c

    def advisory(self, aid: str):
        if aid not in self.advs:
            try:
                if aid.upper().startswith("GHSA-"):
                    d = self.net.json(f"https://api.github.com/advisories/{aid}")
                    self.advs[aid] = [d] if isinstance(d, dict) and d.get("ghsa_id") else f"not found in the GitHub Advisory Database"
                else:
                    d = self.net.json(f"https://api.github.com/advisories?cve_id={aid}")
                    self.advs[aid] = [x for x in d if isinstance(x, dict)] if isinstance(d, list) and d else "not found in the GitHub Advisory Database"
            except urllib.error.HTTPError as e:
                self.advs[aid] = ("not found in the GitHub Advisory Database" if e.code == 404
                                  else f"the GitHub Advisory Database answered HTTP {e.code}")
            except (urllib.error.URLError, http.client.HTTPException, ValueError, OSError) as e:
                self.advs[aid] = f"the GitHub Advisory Database did not answer ({type(e).__name__}: {e})"
        return self.advs[aid]

    @staticmethod
    def _for_repo(adv: dict, repo: str) -> list:
        """The patched versions of the advisory's vulnerabilities when it is for REPO (owner/name), else []."""
        r = repo.lower()
        src = (adv.get("source_code_location") or "").lower().rstrip("/")
        vulns = adv.get("vulnerabilities") or []
        by_src = src.endswith("github.com/" + r)
        by_pkg = any(((v.get("package") or {}).get("name") or "").lower() in (r.split("/")[-1], "github.com/" + r)
                     or ((v.get("package") or {}).get("name") or "").lower().startswith("github.com/" + r + "/") for v in vulns)
        if not (by_src or by_pkg):
            return []
        return [v["first_patched_version"] for v in vulns if v.get("first_patched_version")]

    def patched_for(self, repo: str):
        """(patched version, id) of the lowest patched version over the ids confirmed for REPO, or None."""
        best = None
        for aid in self.ids:
            advs = self.advisory(aid)
            if isinstance(advs, str):
                continue
            for adv in advs:
                for pv in self._for_repo(adv, repo):
                    self.matched[aid] = repo
                    if best is None or vkey(pv) < vkey(best[0]):
                        best = (pv, aid)
        return best

    def refusals(self) -> list:
        out = []
        for aid in self.ids:
            if aid in self.matched:
                continue
            advs = self.advisory(aid)
            if isinstance(advs, str):
                out.append(f"--allow-security {aid} refused: {advs}")
            else:
                where = ", ".join(sorted({(a.get("source_code_location") or "?") for a in advs}))
                out.append(f"--allow-security {aid} refused: the advisory is for {where} (no patched version), "
                           f"which matches no pinned core service")
        return out


# ------------------------------------------------------------------------------------------------------ sources
class GithubReleases:
    """Stable (not draft, not pre-release) GitHub releases whose tag matches TAG_RX (group 1 = the version)."""

    def __init__(self, repo: str, tag_rx: str):
        self.repo, self.tag_rx = repo, re.compile(tag_rx)

    def candidates(self, net: Net) -> list[Candidate]:
        out = []
        for page in (1, 2, 3):
            rels = net.json(f"https://api.github.com/repos/{self.repo}/releases?per_page=60&page={page}")
            for r in rels:
                m = self.tag_rx.fullmatch(r.get("tag_name") or "")
                if not m or r.get("draft") or r.get("prerelease"):
                    continue
                out.append(Candidate(m.group(1), parse_time(r["published_at"]),
                                     r.get("html_url") or f"https://github.com/{self.repo}/releases/tag/{r['tag_name']}",
                                     r.get("body") or ""))
            if len(rels) < 60 or len(out) >= 40:
                break
        return out


class HubTags:
    """Docker Hub tags of REPO matching TAG_RX (group 1 = the version); the tag's push date is its release date."""

    def __init__(self, repo: str, tag_rx: str, name_filter: str = ""):
        self.repo, self.tag_rx, self.name_filter = repo, re.compile(tag_rx), name_filter

    def candidates(self, net: Net) -> list[Candidate]:
        url = (f"https://hub.docker.com/v2/repositories/{hub_repo(self.repo)}/tags?page_size=100&ordering=last_updated"
               + (f"&name={self.name_filter}" if self.name_filter else ""))
        out, pages = [], 0
        while url and pages < 6:
            d = net.json(url)
            for t in d.get("results", []):
                m = self.tag_rx.fullmatch(t.get("name") or "")
                when = t.get("tag_last_pushed") or t.get("last_updated")
                if m and when:
                    out.append(Candidate(m.group(1), parse_time(when), f"https://hub.docker.com/r/{self.repo}/tags"))
            url, pages = d.get("next"), pages + 1
            if url and https_host(url) != "hub.docker.com":
                raise ValueError(f"Docker Hub's next page is not on https://hub.docker.com: {url!r}")
        return out


# ------------------------------------------------------------------------------------------------------ edits
class Files:
    """A tiny read/modify/write layer: edits are kept in memory and written only by flush() (never with --check)."""

    def __init__(self, root: str):
        self.root, self.text, self.orig = root, {}, {}

    def get(self, rel: str) -> str:
        if rel not in self.text:
            try:
                with open(os.path.join(self.root, rel), encoding="utf-8") as f:
                    self.orig[rel] = self.text[rel] = f.read()
            except FileNotFoundError:
                self.orig[rel] = self.text[rel] = ""
        return self.text[rel]

    def put(self, rel: str, s: str) -> None:
        self.get(rel)
        self.text[rel] = s

    def flush(self) -> list[str]:
        changed = []
        for rel, s in self.text.items():
            if s != self.orig[rel]:
                os.makedirs(os.path.dirname(os.path.join(self.root, rel)), exist_ok=True)
                with open(os.path.join(self.root, rel), "w", encoding="utf-8") as f:
                    f.write(s)
                changed.append(rel)
        return changed


NUM_VERSION = r"\d+(?:\.\d+)*"


def tag_rx_of(template: str, vrx: str = NUM_VERSION) -> str:
    """'{v}-slim' -> a regex whose group 'v' is the version part."""
    return re.escape(template).replace(re.escape("{v}"), "(?P<v>" + vrx + ")")


def image_rx(repo: str, template: str, vrx: str = NUM_VERSION) -> re.Pattern:
    return re.compile(r"(?<![\w/.\-])" + re.escape(repo) + ":" + tag_rx_of(template, vrx) + r"(?P<d>" + DIGEST_RX + r")?(?![\w.\-])")


def current_image_version(text: str, repo: str, template: str, vrx: str = NUM_VERSION) -> str | None:
    m = image_rx(repo, template, vrx).search(text)
    return m.group("v") if m else None


def rewrite_image(text: str, repo: str, template: str, version: str, digest: str | None, vrx: str = NUM_VERSION) -> str:
    new = f"{repo}:{template.replace('{v}', version)}" + (f"@{digest}" if digest else "")
    return image_rx(repo, template, vrx).sub(lambda m: new, text)


def arg_value(text: str, name: str) -> str | None:
    m = re.search(rf"^ARG {re.escape(name)}=(\S*)", text, re.M)
    return m.group(1) if m else None


def rewrite_arg(text: str, name: str, value: str) -> str:
    return re.sub(rf"^(ARG {re.escape(name)}=)\S*", lambda m: m.group(1) + value, text, flags=re.M)


# ------------------------------------------------------------------------------------------------------ targets
E2E_TESTED = "tests/e2e/browser/common.py"
GOLDEN_DIR = "tests/fixtures/compose-golden"


class Move:
    def __init__(self, name, old, new, newest, url="", why="", released=None, held=False):
        self.name, self.old, self.new, self.newest, self.url, self.why = name, old, new, newest, url, why
        self.released, self.held = released, held
        self.newest_url, self.newest_released = url, released   # of the newest release (ImageTarget sets them)

    @property
    def changed(self) -> bool:
        return self.old != self.new


class ImageTarget:
    """A pinned image (compose.yaml and/or Dockerfiles): moves to the newest release past the cooldown, with its
    digest. IMAGES: [(repo, tag template with {v})], the same version for every one (Caddy: -alpine and -builder-alpine)."""

    def __init__(self, name, label, source, images, files, args=(), service="", vrx=NUM_VERSION, tested=""):
        self.name, self.label, self.source, self.images, self.files, self.args, self.service = name, label, source, images, files, args, service
        self.vrx, self.tested = vrx, tested

    def current(self, fs: Files) -> str:
        repo, tpl = self.images[0]
        for f in self.files:
            v = current_image_version(fs.get(f), repo, tpl, self.vrx)
            if v:
                return v
        raise SystemExit(f"{self.name}: no pin for {repo} in {', '.join(self.files)}")

    def pinned_digest(self, fs: Files, repo: str, tpl: str) -> str | None:
        for f in self.files:
            m = image_rx(repo, tpl, self.vrx).search(fs.get(f))
            if m and m.group("d"):
                return m.group("d")[1:]
        return None

    def run(self, net, fs: Files, now, cooldown, allow=None) -> Move:
        cur = self.current(fs)
        cands = self.source.candidates(net)
        emb = allow.embargoed(self, cands, cur) if allow else None
        chosen, newest, why = pick(cands, cur, now, cooldown, patched_of(self.source, allow), emb)
        if chosen is None:
            raise SystemExit(f"{self.name}: no stable release found upstream")
        v = chosen.version
        digests, hold = {}, ""
        for repo, tpl in self.images:
            held = self.pinned_digest(fs, repo, tpl) if v == cur else None  # the same release keeps its digest (cooldown)
            if held:
                digests[(repo, tpl)] = held
            else:
                reg, nm = registry_of(repo)
                digests[(repo, tpl)] = net.digest(reg, nm, tpl.replace("{v}", v))
                # (a release inside the cooldown is here only by a security override, which knows it is new)
                if age_days(chosen.released, now) >= cooldown:
                    note, wait = built_check(net, self.name, reg, nm, tpl.replace("{v}", v), digests[(repo, tpl)],
                                             chosen.released, now, cooldown)
                    why, hold = "; ".join(x for x in (why, note) if x), hold or wait
        if hold:   # the cooldown counts from the build when it is later: nothing moves yet
            m = Move(self.name, cur, cur, newest.version, chosen.url, "; ".join(x for x in (hold, why) if x), chosen.released, True)
            m.newest_url, m.newest_released = newest.url, newest.released
            return m
        # (+ tests/fixtures/compose-golden/*.json: the images compose renders, which tests/test_brand.sh compares)
        goldens = sorted(str(q.relative_to(fs.root)) for q in Path(fs.root, GOLDEN_DIR).glob("*.json"))
        for f in list(self.files) + goldens:
            s = fs.get(f)
            for repo, tpl in self.images:
                s = rewrite_image(s, repo, tpl, v, digests[(repo, tpl)], self.vrx)
            for argname in self.args:
                if f in self.files:
                    s = rewrite_arg(s, argname, v)
            fs.put(f, s)
        if self.tested:  # tests/e2e/browser/common.py: the versions the e2e suite was run with
            t = fs.get(E2E_TESTED)
            fs.put(E2E_TESTED, re.sub(rf'("{re.escape(self.tested)}": ")[^"]*(")',
                                      lambda m: m.group(1) + self.images[0][1].replace("{v}", v) + m.group(2), t))
        m = Move(self.name, cur, v, newest.version, chosen.url, why, chosen.released, chosen is not newest)
        m.newest_url, m.newest_released = newest.url, newest.released
        return m


def built_check(net, target: str, reg: str, name: str, tag: str, digest: str, released, now, cooldown: int):
    """(note, hold) for a digest just read: the cooldown was judged on the release (or the tag's push), but a tag
    pushed again since would slip in under it. The image's build time inside the cooldown holds the move back — and
    refuses it when the build is well after the release (REPUSH_DAYS): the tag was pushed again, look upstream."""
    built = net.built(reg, name, digest)
    if built is None:
        return "the image's build time is unreadable: the cooldown counted from the release", ""
    if age_days(built, now) >= cooldown:
        return "", ""
    if age_days(released, built) > REPUSH_DAYS:
        raise Refused(f"{target} refused: {name}:{tag} ({digest[:19]}) was built {age_days(built, now):.1f} days ago, "
                      f"{age_days(released, built):.0f} days after its release, inside the {cooldown}-day cooldown: the tag "
                      "was pushed again since? Not pinned; look upstream before taking it")
    return "", f"held back: {name}:{tag} was built {age_days(built, now):.1f}d ago (the cooldown counts from the build)"


class BaseTarget:
    """A base image whose tag is kept (python:3.12-slim): only its digest moves, and only when the tag's newest push is
    past the cooldown. Node pins a patch version in the tag (node:24.21.0-trixie-slim), so it is an ImageTarget."""

    def __init__(self, name, label, repo, tag, files):
        self.name, self.label, self.repo, self.tag, self.files = name, label, repo, tag, files

    def run(self, net, fs: Files, now, cooldown, allow=None) -> Move:
        hub = HubTags(self.repo, re.escape(self.tag).join(["(", ")"]), self.tag)
        cands = [c for c in hub.candidates(net) if c.version == self.tag]
        pat = re.compile(r"(?<![\w/.\-])" + re.escape(self.repo) + ":" + re.escape(self.tag) + r"(?:" + DIGEST_RX + r")?(?![\w.\-])")
        old = ""
        for f in self.files:
            m = re.search(re.escape(self.repo) + ":" + re.escape(self.tag) + "@(sha256:[0-9a-f]{64})", fs.get(f))
            if m:
                old = m.group(1)
                break
        if not cands:
            return Move(self.name, old[:19], old[:19], old[:19])
        c = cands[0]
        reg, nm = registry_of(self.repo)
        if age_days(c.released, now) < cooldown:
            return Move(self.name, old[:19], old[:19], "newer push", c.url, f"held back: pushed {int(age_days(c.released, now))}d ago", c.released, True)
        dg = net.digest(reg, nm, self.tag)
        why, hold = built_check(net, self.name, reg, nm, self.tag, dg, c.released, now, cooldown) if dg != old else ("", "")
        if hold:
            return Move(self.name, old[:19], old[:19], "newer push", c.url, hold, c.released, True)
        for f in self.files:
            fs.put(f, pat.sub(f"{self.repo}:{self.tag}@{dg}", fs.get(f)))
        return Move(self.name, old[:19], dg[:19], dg[:19], c.url, why, c.released)


class ToolTarget:
    """A release binary downloaded in terminal/Dockerfile: VERSION arg and the SHA-256 args of its two files."""

    def __init__(self, name, label, source, prefix, assets, file="terminal/Dockerfile"):
        # assets: {"AMD64": "url template with {v}", "ARM64": "..."}
        self.name, self.label, self.source, self.prefix, self.assets, self.file = name, label, source, prefix, assets, file

    def run(self, net, fs: Files, now, cooldown, allow=None) -> Move:
        s = fs.get(self.file)
        cur = arg_value(s, self.prefix + "_VERSION")
        if cur is None:
            raise SystemExit(f"{self.name}: no ARG {self.prefix}_VERSION in {self.file}")
        chosen, newest, why = pick(self.source.candidates(net), cur, now, cooldown, patched_of(self.source, allow))
        if chosen is None:
            raise SystemExit(f"{self.name}: no stable release found upstream")
        if chosen.version != cur:
            s = rewrite_arg(s, self.prefix + "_VERSION", chosen.version)
            for arch, tpl in self.assets.items():
                s = rewrite_arg(s, f"{self.prefix}_SHA256_{arch}", net.sha256(tpl.replace("{v}", chosen.version)))
            fs.put(self.file, s)
        return Move(self.name, cur, chosen.version, newest.version, chosen.url, why, chosen.released, chosen is not newest)


class PipLock:
    """requirements.in -> requirements.txt with hashes (uv pip compile --generate-hashes), nothing newer than the
    cooldown (--exclude-newer). Reports the packages that moved."""

    def __init__(self, name, directory):
        self.name, self.dir = name, directory

    @staticmethod
    def pins(text: str) -> dict:
        return {m.group(1).lower(): m.group(2) for m in re.finditer(r"^([A-Za-z0-9_.\-]+)==(\S+)", text, re.M)}

    def run(self, net, fs: Files, now, cooldown, runner=None, apply=True) -> Move:
        rel = f"{self.dir}/requirements.txt"
        old = self.pins(fs.get(rel))
        cutoff = (now - dt.timedelta(days=cooldown)).strftime("%Y-%m-%dT%H:%M:%SZ")
        with tempfile.TemporaryDirectory() as td:
            out = os.path.join(td, "requirements.txt")
            with open(out, "w", encoding="utf-8") as f:
                f.write(fs.get(rel))
            cmd = ["uv", "pip", "compile", "--quiet", "--generate-hashes", "--python-version", "3.12", "--upgrade",
                   "--exclude-newer", cutoff, "requirements.in", "-o", out]
            (runner or run_cmd)(cmd, os.path.join(fs.root, self.dir))
            with open(out, encoding="utf-8") as f:
                new_text = f.read()
        # uv writes the -o path into its header: keep the file's own header
        new_text = re.sub(r"(-o )\S+requirements\.txt", r"\1requirements.txt", new_text)
        new = self.pins(new_text)
        moved = [f"{n} {old[n]} -> {new[n]}" for n in sorted(new) if n in old and old[n] != new[n]]
        added = [f"{n} {new[n]} (new)" for n in sorted(new) if n not in old]
        gone = [f"{n} (removed)" for n in sorted(old) if n not in new]
        if moved or added or gone:
            fs.put(rel, new_text)
        ch = moved + added + gone
        return Move(self.name, f"{len(old)} pins", f"{len(old)} pins, {len(ch)} moved" if ch else f"{len(old)} pins",
                    "", "https://pypi.org/", "; ".join(ch[:12]) + (" …" if len(ch) > 12 else ""))


def patched_of(source, allow):
    """The (patched version, id) a --allow-security advisory confirms for the source's GitHub repo (None: no bypass)."""
    return allow.patched_for(source.repo) if allow and isinstance(source, GithubReleases) else None


def run_cmd(cmd, cwd):
    subprocess.run(cmd, cwd=cwd, check=True)


def targets() -> list:
    gh = lambda repo, rx: GithubReleases(repo, rx)
    ver = r"(\d+\.\d+\.\d+)"
    return [
        ImageTarget("litellm", "LiteLLM", gh("BerriAI/litellm", "v" + ver), [("ghcr.io/berriai/litellm", "{v}")], ["compose.yaml"], service="litellm", tested="litellm"),
        ImageTarget("open-webui", "Open WebUI", gh("open-webui/open-webui", "v" + ver), [("ghcr.io/open-webui/open-webui", "v{v}-slim")],
                    ["compose.yaml", "open-webui/Dockerfile"], service="open-webui", tested="open-webui"),
        ImageTarget("rustfs", "RustFS", gh("rustfs/rustfs", ver), [("rustfs/rustfs", "{v}")], ["compose.yaml"], service="rustfs", tested="rustfs"),
        ImageTarget("caddy", "Caddy", gh("caddyserver/caddy", "v" + ver), [("caddy", "{v}-alpine"), ("caddy", "{v}-builder-alpine")],
                    ["compose.yaml", "compose.terminal.yaml", "caddy/Dockerfile", "tests/caddy-validate.sh"], args=("CADDY_VERSION",), service="caddy"),
        ImageTarget("tailscale", "Tailscale (remote access)", gh("tailscale/tailscale", "v" + ver), [("tailscale/tailscale", "v{v}")], ["compose.tailscale.yaml"]),
