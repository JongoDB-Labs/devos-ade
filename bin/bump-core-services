        ImageTarget("aws-cli", "AWS CLI (bucket setup)", HubTags("amazon/aws-cli", ver, "2."), [("amazon/aws-cli", "{v}")], ["compose.yaml"], service="rustfs-init"),
        # Ollama (lib/runtimes.sh): its image on Linux, its own release build on a Mac (catalog/runtimes.pins) — the same release
        ImageTarget("ollama", "Ollama (local models, Linux)", gh("ollama/ollama", "v" + ver), [("ollama/ollama", "{v}")], ["compose.yaml"]),
