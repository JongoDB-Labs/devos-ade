# Pins a maintainer holds back on purpose: reported (old -> new, with the reason), never rewritten, until the hold is
# removed here. A hold is for something the maintainers cannot test with what they have.
HOLDS = {"tailscale": "remote access needs a real tailnet to test; bump it by hand after testing there"}

# Not covered (said in the report): Cursor CLI (no release feed or checksum: terminal/Dockerfile's CURSOR_* are moved by
# hand), the npm tools' lockfiles (terminal/claude-code, terminal/tools/gemini and grok: npm install in those folders),
# TTYD_PAGE_SCRIPT_SHA256 (changes only with a new ttyd), llama.cpp (a release names its build only in an asset, nightly-tag.txt:
# the build's macOS archives and its GHCR images are pinned by hand, together), LM Studio (no release feed: its install
# script names the version), vLLM (two images, its CPU build's tag per architecture: pinned by hand, together).
NOT_COVERED = ("Cursor CLI, the npm tool lockfiles (terminal/claude-code, terminal/tools/*), llama.cpp (catalog/runtimes.pins "
               "LLAMACPP_*, its images in compose.yaml and compose.llamacpp-gpu.yaml), LM Studio (LMSTUDIO_*) and vLLM "
               "(VLLM_VERSION, its images in compose.yaml and compose.vllm-gpu.yaml) are bumped by hand")

MANIFEST = "catalog/core-services.tsv"
OVERRIDES = "catalog/core-services-overrides.tsv"
OVERRIDES_HEADER = ("# Security overrides of the 3-day cooldown (bin/bump-core-services --allow-security-embargoed): a pin taken before its\n"
                    "# advisory was public. bump-core-services --check says when the GHSA appears; then delete the row.\n"
                    "#\n# service  version  date  reason  release_url\n")


def read_overrides(text: str) -> list:
    return [l.split("\t") for l in text.splitlines() if l.strip() and not l.startswith("#") and l.count("\t") >= 4]


def write_overrides(rows: list) -> str:
    return OVERRIDES_HEADER + "".join("\t".join(r[:5]) + "\n" for r in rows)


def public_advisory(net, repo: str, version: str) -> str:
    """The GHSA id of a published advisory of REPO that is patched in VERSION ('' when none is public yet)."""
    try:
        advs = net.json(f"https://api.github.com/repos/{repo}/security-advisories?per_page=100")
    except (urllib.error.URLError, http.client.HTTPException, ValueError, OSError):
        return ""
    for a in advs if isinstance(advs, list) else []:
        for v in a.get("vulnerabilities") or []:
            if version in re.split(r"[,\s]+", (v.get("patched_versions") or "").replace("v", "")):
                return a.get("ghsa_id") or ""
    return ""
HEADER = ("# The core services DevOS ADE pins, and the newest stable upstream release when bin/bump-core-services last ran\n"
          "# (docs/releasing.md: every release runs it). ./stack versions and Settings read it: the pinned version comes from\n"
          "# compose.yaml itself, this table adds what upstream has and where its notes are.\n"
          "#\n# id (compose service)  name  newest_upstream  released (date)  notes_url  checked (date)\n")


def write_manifest(moves: dict, now: dt.datetime) -> str:
    rows = []
    for t in targets():
        if not isinstance(t, ImageTarget) or not t.service or t.name not in moves:
            continue
        m = moves[t.name]
        rows.append("\t".join([t.service, t.label, m.newest, (m.newest_released or now).strftime("%Y-%m-%d"),
                               m.newest_url or m.url, now.astimezone().strftime("%Y-%m-%d")]))
    return HEADER + "\n".join(rows) + "\n"


# ------------------------------------------------------------------------------------------------------ main
def table(moves: list[Move]) -> str:
    rows = [("Service", "Old", "New", "Notes")]
    for m in moves:
        arrow = m.new if m.changed else "(up to date)"
        note = (m.url or "") + (f"  [{m.why}]" if m.why else "")
        rows.append((m.name, m.old, arrow, note.strip()))
    w = [max(len(r[i]) for r in rows) for i in range(3)]
    return "\n".join("  ".join(r[i].ljust(w[i]) for i in range(3)) + "  " + r[3] for r in rows)


def main(argv=None, net=None, root=None, runner=None, out=sys.stdout) -> int:
    ap = argparse.ArgumentParser(prog="bump-core-services", description="Bring every pinned core service to its newest tested release.")
    ap.add_argument("--check", action="store_true", help="only report; change no file (exit 3 when something would move)")
    ap.add_argument("--only", help="comma list of target names")
    ap.add_argument("--now", help="the clock the cooldown counts from (ISO time; default now)")
    ap.add_argument("--allow-security", action="append", default=[], metavar="ID",
                    help="GHSA-... or CVE-... id of a security advisory: skips the cooldown for the oldest release that "
                         "patches it, after the GitHub Advisory Database confirms it for that repo (repeatable). Release-note "
                         "text alone never skips the cooldown.")
    ap.add_argument("--allow-security-embargoed", action="append", default=[], metavar="SERVICE=VERSION",
                    help="for an upstream that announces security fixes before the advisory is public: take this release of "
                         "SERVICE (needs --reason). Only an official release of the canonical repo whose notes say it has "
                         "security fixes; recorded in catalog/core-services-overrides.tsv until the advisory appears.")
    ap.add_argument("--reason", default="", help="why --allow-security-embargoed skips the cooldown (recorded)")
    ap.add_argument("--cooldown-days", type=int, default=COOLDOWN_DAYS)
    a = ap.parse_args(argv)
    root = root or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    net = net or Net()
    now = parse_time(a.now) if a.now else dt.datetime.now(dt.timezone.utc)
    only = set(filter(None, (a.only or "").split(",")))
    emb = {}
    for spec in a.allow_security_embargoed:
        name, _, ver = spec.partition("=")
        if not name or not ver:
            print(f"error: --allow-security-embargoed {spec} refused: use SERVICE=VERSION", file=out)
            return 1
        emb[name] = ver.lstrip("v")
    known = {t.name for t in targets() if isinstance(t, ImageTarget)}
    for name in emb:
        if name not in known:
            print(f"error: --allow-security-embargoed {name}=... refused: no such pinned image service ({', '.join(sorted(known))})", file=out)
            return 1
    if emb and not a.reason.strip():
        print("error: --allow-security-embargoed refused: --reason \"...\" is required (why the cooldown is skipped)", file=out)
        return 1
    allow = Allow(a.allow_security, net, emb, a.reason) if (a.allow_security or emb) else None
    fs = Files(root)
    moves: dict = {}
    errors = []
    for t in targets():
        if only and t.name not in only:
            continue
        try:
            if isinstance(t, PipLock):
                moves[t.name] = t.run(net, fs, now, a.cooldown_days, runner)
            elif t.name in HOLDS:   # looked at on a copy that is never written
                m = t.run(net, Files(root), now, a.cooldown_days, allow)
                m.why, m.new, m.held = f"HELD ({HOLDS[t.name]}); would move to {m.new}", m.old, True
                moves[t.name] = m
            else:
                moves[t.name] = t.run(net, fs, now, a.cooldown_days, allow)
        except Refused as e:
            errors.append(str(e))
        except (urllib.error.URLError, http.client.HTTPException, subprocess.CalledProcessError, OSError, KeyError, ValueError) as e:
            errors.append(f"{t.name}: {type(e).__name__}: {e}")
    # security overrides: the ones recorded before + the ones this run applied
    rows = read_overrides(fs.get(OVERRIDES))
    for name, c in (allow.used if allow else {}).items():
        rows = [r for r in rows if not (r[0] == name and r[1] == c.version)] + [
            [name, c.version, now.strftime("%Y-%m-%d"), " ".join(a.reason.split()), c.url]]
    fs.put(OVERRIDES, write_overrides(rows) if rows else fs.get(OVERRIDES))
    by_target = {t.name: t for t in targets()}
    for r in rows:
        m = moves.get(r[0])
        if m is None or m.new != r[1]:
            continue
        m.why = m.why.replace("security override: advisory pending (--allow-security-embargoed)", "").strip("; ")
        ghsa = public_advisory(net, by_target[r[0]].source.repo, r[1]) if isinstance(getattr(by_target[r[0]], "source", None), GithubReleases) else ""
        m.why = ((f"security override: advisory {ghsa} is now public, retire the override (delete its row in {OVERRIDES})" if ghsa
                  else "security override: advisory pending") + ("; " + m.why if m.why else "")).strip()
    ml = list(moves.values())
    print(table(ml), file=out)
    if not only and not errors:
        fs.put(MANIFEST, write_manifest(moves, now))
    for m in ml:
        if m.why.startswith("REVIEW") or "is now public" in m.why:
            print(f"!! {m.name}: {m.why}", file=out)
    for e in errors:
        print("error: " + e, file=out)
    if allow:
        for r in allow.refusals():
            errors.append(r)
            print("error: " + r, file=out)
    print("not covered: " + NOT_COVERED, file=out)
    pending = [m for m in ml if m.changed]
    if a.check:
        print(f"{len(pending)} of {len(ml)} to bump (cooldown {a.cooldown_days} days; --check changed nothing)", file=out)
        return 1 if errors else (3 if pending else 0)
    changed = fs.flush()
    print(f"{len(pending)} bumped; files changed: {', '.join(changed) or 'none'}", file=out)
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
