{
 "name": "bedrock-now",
 "networks": {
  "default": {
   "external": false,
   "name": "bedrock-now_default"
  },
  "stt": {
   "external": false,
   "name": "bedrock-now_stt"
  }
 },
 "services": {
  "caddy": {
   "container_name": null,
   "image": "caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f",
   "labels": {},
   "networks": [
    "default",
    "stt"
   ],
   "ports": [
    {
     "host_ip": "127.0.0.1",
     "protocol": "tcp",
     "published": "80",
     "target": "8080"
    }
   ],
   "volumes": [
    {
     "read_only": true,
     "source": "<STACK>/caddy",
     "target": "/etc/caddy",
     "type": "bind"
    }
   ]
  },
  "litellm": {
   "container_name": null,
   "image": "ghcr.io/berriai/litellm:1.105.0",
   "labels": {},
   "networks": [
    "default",
    "stt"
   ],
   "ports": [
    {
     "host_ip": "127.0.0.1",
     "protocol": "tcp",
     "published": "4000",
     "target": "4000"
    }
   ],
   "volumes": [
    {
     "read_only": true,
     "source": "<STACK>/litellm",
     "target": "/app/config",
     "type": "bind"
    }
   ]
  },
  "open-webui": {
   "container_name": null,
   "image": "ghcr.io/open-webui/open-webui:v0.12.0-slim",
   "labels": {},
   "networks": [
    "default"
   ],
   "ports": [],
   "volumes": [
    {
     "source": "owui",
     "target": "/app/backend/data",
     "type": "volume"
    }
   ]
  },
  "portal": {
   "container_name": null,
   "image": "bedrock-now/portal:local",
   "labels": {},
   "networks": [
    "default"
   ],
   "ports": [],
   "volumes": [
    {
     "read_only": true,
     "source": "<STACK>/litellm",
     "target": "/data/litellm",
     "type": "bind"
    },
    {
     "source": "<STACK>/litellm/prices",
     "target": "/data/prices",
     "type": "bind"
    },
    {
     "read_only": true,
     "source": "<STACK>/catalog",
     "target": "/data/catalog",
     "type": "bind"
    },
    {
     "read_only": true,
     "source": "<STACK>/.state/status",
     "target": "/data/status",
     "type": "bind"
    },
    {
     "source": "<STACK>/.state/update-check",
     "target": "/data/update-check",
     "type": "bind"
    },
    {
     "source": "<STACK>/.state/requests",
     "target": "/data/requests",
     "type": "bind"
    },
    {
     "source": "portal-state",
     "target": "/state",
     "type": "volume"
    }
   ]
  },
  "postgres": {
   "container_name": null,
   "image": "pgvector/pgvector:0.8.7-pg17",
   "labels": {},
   "networks": [
    "default"
   ],
   "ports": [],
   "volumes": [
    {
     "source": "pgdata",
     "target": "/var/lib/postgresql/data",
     "type": "volume"
    },
    {
     "read_only": true,
     "source": "<STACK>/postgres/init.sql",
     "target": "/docker-entrypoint-initdb.d/10-init.sql",
     "type": "bind"
    }
   ]
  },
  "rustfs": {
   "container_name": null,
   "image": "rustfs/rustfs:1.0.1",
   "labels": {},
   "networks": [
    "default"
   ],
   "ports": [],
   "volumes": [
    {
     "source": "s3data",
     "target": "/data",
     "type": "volume"
    }
   ]
  },
  "rustfs-init": {
   "container_name": null,
   "image": "amazon/aws-cli:2.37.12",
   "labels": {},
   "networks": [
    "default"
   ],
   "ports": [],
   "volumes": []
  },
  "shared-mcp": {
   "container_name": null,
   "image": "bedrock-now/shared-mcp:local",
   "labels": {},
   "networks": [
    "default"
   ],
   "ports": [
    {
     "host_ip": "127.0.0.1",
     "protocol": "tcp",
     "published": "8765",
     "target": "8000"
    }
   ],
   "volumes": []
  }
 },
 "volumes": {
  "owui": {
   "external": false,
   "name": "bedrock-now_owui"
  },
  "pgdata": {
   "external": false,
   "name": "bedrock-now_pgdata"
  },
  "portal-state": {
   "external": false,
   "name": "bedrock-now_portal-state"
  },
  "s3data": {
   "external": false,
   "name": "bedrock-now_s3data"
  }
 }
}
