# Interactive shells in the DevOS ADE terminal (sourced from /etc/bash.bashrc; tmux starts non-login shells, so
# bash reads your own ~/.bashrc, kept in the terminal-home volume, right after this).
case $- in *i*) ;; *) return ;; esac
PS1='\[\e[36m\]terminal\[\e[0m\] \w \$ '
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth
shopt -s histappend checkwinsize
alias ls='ls --color=auto' ll='ls -alF' grep='grep --color=auto'

# Auto mode's reviewer (Claude Code's classifier) on this terminal's Haiku, for `claude` typed here as for devos-claude
# (terminal/bin/devos-claude): a Claude model whatever the session's, at a twentieth of Sonnet 5.5's price
case "${ANTHROPIC_DEFAULT_HAIKU_MODEL:-}" in
  claude-haiku-*) export CLAUDE_CODE_AUTO_MODE_MODEL="${CLAUDE_CODE_AUTO_MODE_MODEL:-$ANTHROPIC_DEFAULT_HAIKU_MODEL}" ;;
esac

# Claude Code's auto mode off for `claude` typed here unless Settings › Claude Code › Auto mode in the terminal is on
# (TERMINAL_AUTO_MODE). The sandbox's managed settings turn it off already while both auto mode switches are off; with
# only the Code page's on they must leave it available (the Code page's sessions need it), so this adds Claude Code's
# flag-tier switch to sessions started here — not to a subcommand (they refuse --settings). A convenience, not a
# boundary: /usr/local/bin/claude called directly, or a --settings of yours (Claude Code takes the last), goes without it.
# `claude` here is Claude Code on Bedrock (the terminal's key), so it signs in to no Claude account: `auth login` and
# `setup-token` are refused, pointing to claude-sub (JON-1050; /login is hidden by the terminal's environment). With
# the Code page's Auto mode on and this one off, an interactive session says which switch it is (JON-1051).
_bn_on() { case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in true | 1 | yes | on) return 0 ;; esac; return 1; }
claude() {
  case "${1:-}:${2:-}" in
    auth:login | setup-token:*)
      printf '%s\n' "claude: claude here is Claude Code on Bedrock (this terminal's key) and signs in to no Claude account. Claude on your plan is claude-sub — claude-sub auth login, or /login in it" >&2
      return 2 ;;
  esac
  if _bn_on "${TERMINAL_AUTO_MODE:-}"; then command claude "$@"; return; fi
  if [ -z "${_BN_CLAUDE_SUBCMDS+x}" ]; then
    _BN_CLAUDE_SUBCMDS="$(command claude --help 2>/dev/null </dev/null | awk '/^Commands:/ { f = 1; next } f && /^[^ ]/ { f = 0 }
      f && /^  [a-z]/ { n = split($1, a, "|"); for (i = 1; i <= n; i++) print a[i] }' || true)"
  fi
  local c
  case "${1:-}" in
    '' | -*) ;;
    *) for c in $_BN_CLAUDE_SUBCMDS; do [ "$c" = "$1" ] && { command claude "$@"; return; }; done ;;
  esac
  if [ -t 2 ] && _bn_on "${BN_CODE_AUTO_MODE:-}"; then
    printf '%s\n' "claude: auto mode is off in the terminal — the Code page's Auto mode is its own; Settings › Claude Code › Auto mode in the terminal turns it on here" >&2
  fi
  command claude '--settings={"disableAutoMode":"disable"}' "$@"
}
