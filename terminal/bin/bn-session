#!/bin/bash
# What ttyd runs for each browser connection: attach to the one tmux session, "claude" — or create it, with
# devos-claude in /workspace as its first window, named "bedrock" (Claude Code on Bedrock; a shell takes over once it
# exits). Closing the tab only detaches; Ctrl-b c opens another shell window.
#
# The pickers ("who answers": the Terminal tab, the Code page's terminal panel, the Chat tab) add words to the address
# (?arg=…, which ttyd's --url-arg hands over as arguments — never through a shell):
#   open TOOL[:NAME] TOKEN [DIR]   a window running TOOL (`subscriptions open TOOL[:NAME]`: its own sign-in first when
#                           it is not signed in), named after what runs in it (claude-work for the account "work"; the
#                           first account is TOOL until `subscriptions open` knows its kind and renames the window,
#                           claude-max), made the current one of "claude" — or that window, if it is there already. A
#                           window is found by its window option @bn-open (the id, and the folder's hash), never by its
#                           name, which `subscriptions open` changes and you may too
#   chat TOOL[:NAME] TOKEN [DIR]   the same window, shown alone in a session of its own grouped with "claude"
#                           (chat-TOOL…: the Chat tab's embedded tool; "claude"'s current window stays what it was)
#   add TOOL TOKEN          a window running `subscriptions add TOOL`: it asks for the new account's name, makes its
#                           folder and signs in (the window is then named after the account)
#   view N TOKEN            the Terminal tab's Nth view (N 2 to 4; the first is "claude" itself): a session of its own
#                           grouped with "claude", view-N — the same windows, its own current one — with a new shell window,
#                           shell-N, made current in it when it is made (not "shell": that is the workspace's own, which
#                           Open a shell here finds by its name). Closing a view only detaches it; the next TOKEN (the page
#                           asks for a fresh one on a reload) attaches to what is there.
# TOOL: bedrock (devos-claude), claude (claude-sub, your Claude plan), codex, gemini, copilot, cursor, grok, shell. NAME: an
# account of that tool besides the first (lowercase letters, digits and -: ~/.subscriptions/TOOL/NAME, subscriptions).
# TOKEN: a launch token, <iat>-<16 hex>-<32 hex> — the portal makes one only on your click (in its own page, the Code
# page's hand-off, or the terminal host's own "Open … here?" page) and lets no request to the terminal carry words
# without a valid one for exactly these words (portal/portal/answers.py, app.py launch_gate); here only its form is
# checked (this side cannot tell a real one: the gate did). Each acts once, and only within 10 minutes of when it was
# made (its <iat>: a reconnect — or the same address after the sandbox restarted — only attaches). DIR: /workspace
# or a folder below it, or one of the project folders of your computer (BN_CODE_ROOTS); default /workspace. Anything
# else — more words, other words, a folder elsewhere — is the plain attach above.
set -uo pipefail
S=claude
STATE="${BN_SESSION_STATE:-/tmp/bn-session}"
WS="${BN_CODE_WORKSPACE:-/workspace}"

plain() { exec tmux new-session -A -s "$S" -n bedrock -c "$WS" "devos-claude; exec bash"; }
ensure() { tmux has-session -t "=$S" 2>/dev/null || tmux new-session -d -s "$S" -n bedrock -c "$WS" "devos-claude; exec bash"; }

# take TOKEN: fresh=1 when it was made at most 10 minutes ago (not ahead of this clock by more than 30 s) and nothing has
# used it yet — a token acts once
fresh=0
take() {
  local iat="${1%%-*}" now; now="$(date +%s)"
  if [ $((now - 10#$iat)) -le 600 ] && [ $((10#$iat - now)) -le 30 ]; then
    mkdir -p "$STATE" 2>/dev/null && chmod 700 "$STATE" 2>/dev/null && mkdir "$STATE/$1" 2>/dev/null && fresh=1
  fi
}

[ $# -ge 3 ] && [ $# -le 4 ] || plain
mode="$1" tool="$2" token="$3" dir="${4:-$WS}"
ACCT='^[a-z0-9][a-z0-9-]{0,19}$'   # (an account's name: subscriptions' too)
if [ "$mode" = view ]; then
  [ $# -eq 3 ] && [[ $tool =~ ^[2-4]$ ]] && [[ $token =~ ^[0-9]{10}-[0-9a-f]{16}-[0-9a-f]{32}$ ]] || plain
  view="view-$tool"
  take "$token"
  ensure
  if ! tmux has-session -t "=$view" 2>/dev/null; then
    # (made only for a token that has not acted: a view closed with exit, reconnecting on its old token, is the plain attach)
    [ "$fresh" = 1 ] || plain
    tmux new-session -d -t "=$S" -s "$view" 2>/dev/null || plain
    tmux new-window -t "=$view:" -n "shell-$tool" -c "$WS" "exec bash" 2>/dev/null || true
  fi
  exec tmux attach-session -t "=$view"
fi
case "$mode" in open | chat | add) ;; *) plain ;; esac
case "$tool" in
  bedrock | shell) ;;
  claude | codex | gemini | copilot | cursor | grok) ;;
  claude:* | codex:* | gemini:* | copilot:* | cursor:* | grok:*) [ "$mode" != add ] && [[ ${tool#*:} =~ $ACCT ]] || plain ;;
  *) plain ;;
esac
# (add takes a bare tool and no folder: it makes the account's, and its window is in the workspace)
if [ "$mode" = add ]; then [ $# -eq 3 ] || plain; case "$tool" in claude | codex | gemini | copilot | cursor | grok) ;; *) plain ;; esac; fi
[[ $token =~ ^[0-9]{10}-[0-9a-f]{16}-[0-9a-f]{32}$ ]] || plain
# the folder: as it resolves, inside the workspace or a project folder of your computer
case "$dir" in /*) ;; *) plain ;; esac
real="$(cd -- "$dir" 2>/dev/null && pwd -P)" || plain
ok=0
case "$real/" in "$WS"/*) ok=1 ;; esac
if [ "$ok" = 0 ] && [ -n "${BN_CODE_ROOTS:-}" ]; then
  while IFS= read -r r; do
    case "$r" in /?*) case "$real/" in "$r"/*) ok=1 ;; esac ;; esac
  done < <(printf '%s' "$BN_CODE_ROOTS" | jq -r 'if type == "array" then .[] | strings else empty end' 2>/dev/null)
fi
[ "$ok" = 1 ] || plain

# the window: named after what runs in it — the account's (claude-work), else the tool's (the first account's is renamed
# claude-max by `subscriptions open` once it knows the kind; bedrock and shell are as they are) — and, when it is not the
# workspace, the folder's (letters, digits, _ and - only: a "." or ":" would be read as a pane or a window in a tmux
# target) and a short hash of its path (two folders of one name stay two windows). The name is only a label: the window is
# found by its option @bn-open (the id, and "@" + the hash for a folder), which a rename leaves alone; @bn-suffix keeps the
# folder part for the rename.
name="${tool//:/-}"; key="$tool"; suffix=''
[ "$mode" != add ] || { name="$tool-new"; key="add:$tool"; }
if [ "$real" != "$WS" ]; then
  h="$(printf '%s' "$real" | sha256sum | cut -c1-6)"
  suffix="-$(printf '%s' "${real##*/}" | LC_ALL=C tr -c 'A-Za-z0-9_-' '-' | cut -c1-20)-$h"
  name="$name$suffix"; key="$key@$h"
fi
# win_id -> the id (@N) of the window of this key in "claude", empty when there is none
win_id() { tmux list-windows -t "=$S" -F '#{window_id} #{@bn-open}' 2>/dev/null | awk -v k="$key" '$2 == k { print $1; exit }'; }
# a token acts once, and only while fresh (made at most 10 minutes ago, not ahead of this clock by more than 30 s)
take "$token"
ensure
wid="$(win_id)"
if [ "$fresh" = 1 ] && [ -z "$wid" ]; then
  # (the command is fixed words — TOOL[:NAME] is checked above — and the image's own subscriptions by its full path:
  # never one put in ~/.local/bin, which comes first on PATH; the folder with its "#" doubled: tmux reads -c as a format)
  cmd="/usr/local/bin/subscriptions open $tool; exec bash"
  [ "$mode" != add ] || cmd="/usr/local/bin/subscriptions add $tool; exec bash"
  wid="$(tmux new-window -d -P -F '#{window_id}' -t "=$S:" -n "$name" -c "${real//#/##}" "$cmd" 2>/dev/null)" || plain
  if [[ $wid =~ ^@[0-9]+$ ]]; then
    tmux set-option -w -t "=$S:$wid" @bn-open "$key" 2>/dev/null || true
    tmux set-option -w -t "=$S:$wid" @bn-suffix "$suffix" 2>/dev/null || true
    # (one of your subscriptions' tools: its pane marked at once, as its launcher marks it — the Code page's @terminal
    # leaves it alone)
    case "$tool" in bedrock | shell) ;; *) tmux set-option -p -t "=$S:$wid" @bn-sub 1 2>/dev/null || true ;; esac
  else wid=''; fi
fi
if [ "$mode" != chat ]; then
  [ "$fresh" = 0 ] || [ -z "$wid" ] || tmux select-window -t "=$S:$wid" 2>/dev/null || true
  exec tmux attach-session -t "=$S"
fi
view="chat-$name"
if ! tmux has-session -t "=$view" 2>/dev/null; then
  tmux new-session -d -t "=$S" -s "$view" 2>/dev/null || plain
  tmux set-option -t "=$view:" status off 2>/dev/null || true   # (a session option: "=NAME:" — "=NAME" alone is refused)
  fresh=1
fi
[ "$fresh" = 0 ] || [ -z "$wid" ] || tmux select-window -t "=$view:$wid" 2>/dev/null || true
exec tmux attach-session -t "=$view"
