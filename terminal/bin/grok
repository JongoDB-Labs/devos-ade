#!/bin/bash
# grok in the DevOS ADE sandbox: xAI's Grok Build CLI as xAI ships it (/usr/local/lib/bn-tools/grok: its npm package,
# pinned by its lockfile, the binary unpacked at build as its own postinstall would; terminal/Dockerfile's ai-tools
# stage). On your SuperGrok or X Subscription (or Grok Build's free tier): `grok login --device-auth` (a link and a
# short code for your browser), or `subscriptions login grok`; `grok logout`. It keeps the login in ~/.grok/auth.json
# (its own file, which DevOS ADE never opens). Its self-update stays off (--no-auto-update, GROK_DISABLE_AUTOUPDATER):
# the image pins it.
set -euo pipefail
bin="${BN_TOOLS_DIR:-/usr/local/lib/bn-tools}/grok/grok"
[ -x "$bin" ] || { echo "grok: not in this sandbox (left out by TERMINAL_AI_TOOLS in .env — Settings › Claude Code › More — or its download failed when the image was built: ${BN_TOOLS_DIR:-/usr/local/lib/bn-tools}/SKIPPED)" >&2; exit 127; }
umask 077
# The stack's own variables are not this tool's — the gateway and the terminal's LiteLLM key, Bedrock's models and
# switches, the shared MCP server's token, AWS's: left out of its environment, as claude-sub leaves them out
for v in $(compgen -e); do
  case "$v" in
    ANTHROPIC_* | CLAUDE_CODE_* | CLAUDE_BEDROCK_* | CLAUDE_CONFIG_DIR | SHARED_MCP_TOKEN | BN_MCP_URL | AWS_*) unset "$v" ;;
  esac
done
# BN_SUB_ACCOUNT=NAME (subscriptions open grok:NAME): another account of this tool, its login in a folder of its own,
# ~/.subscriptions/grok/NAME — Grok Build reads its folder (default ~/.grok) from GROK_HOME (its launcher and program at the pinned 1.0.67). A name that is not one, or a folder that is not there
# (or is a link, or ~/.subscriptions is), is refused: never a path from outside. Without it, the first account, exactly as before.
if [ -n "${BN_SUB_ACCOUNT:-}" ]; then
  adir="${BN_SUBS_ROOT:-$HOME/.subscriptions}/grok/$BN_SUB_ACCOUNT"
  if ! [[ $BN_SUB_ACCOUNT =~ ^[a-z0-9][a-z0-9-]{0,19}$ ]] || [ ! -d "$adir" ] || [ -L "$adir" ] || [ -L "${adir%/*}" ] || [ -L "${adir%/*/*}" ]; then
    echo "grok: no account called '${BN_SUB_ACCOUNT//[^a-z0-9-]/?}' here (subscriptions accounts grok)" >&2; exit 2
  fi
  export GROK_HOME="$adir"
fi
# (it names the account for this launcher only: a program the tool runs — Claude Code's Bash running codex — picks its own)
unset BN_SUB_ACCOUNT
# A tmux pane running it is marked as one of your subscriptions' tools (pane option @bn-sub): the Code page's @terminal
# leaves its screen alone, where a sign-in's code may show. A guard against an accidental read, not a boundary.
if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] && [ "${BN_SUB_NOMARK:-0}" != 1 ] && [ -x "${BN_TMUX_BIN:-/usr/bin/tmux}" ]; then
  "${BN_TMUX_BIN:-/usr/bin/tmux}" set-option -p -t "$TMUX_PANE" @bn-sub 1 >/dev/null 2>&1 || true
fi
export GROK_DISABLE_AUTOUPDATER=1
exec "$bin" --no-auto-update "$@"
