#!/bin/bash
# codex in the DevOS ADE sandbox: OpenAI's Codex CLI as OpenAI ships it (its package in /usr/local/lib/bn-tools/codex,
# the program bin/codex; pinned and checked when the image was built: terminal/Dockerfile's ai-tools stage). On your
# ChatGPT plan: sign in with `codex login --device-auth` (a link and a one-time code for your browser — first turn on
# "device code login" in ChatGPT's Settings › Security), or `subscriptions login codex`. Its default sign-in waits on
# localhost:1455 inside the sandbox, which your browser cannot reach. Codex keeps the login in ~/.codex/auth.json (the
# terminal-home volume), its own file: DevOS ADE never opens it. Nothing is changed or added here; this file only says
# where it is, and turns off, with Codex's own switches, the two things that would run code from the home instead of
# the image: its shared background server (daemon_auto_start: it copies the package into ~/.codex/packages and runs it
# from there) and its updates (in_app_updates). Codex then runs as before 0.164.0, in the process you start (the error
# "this CLI has no complete local package … --no-daemon" was that server). ./stack update brings the version this
# stack pins.
set -euo pipefail
bin="${BN_TOOLS_DIR:-/usr/local/lib/bn-tools}/codex/bin/codex"
[ -x "$bin" ] || { echo "codex: not in this sandbox (left out by TERMINAL_AI_TOOLS in .env — Settings › Claude Code › More — or its download failed when the image was built: ${BN_TOOLS_DIR:-/usr/local/lib/bn-tools}/SKIPPED)" >&2; exit 127; }
umask 077
# The stack's own variables are not this tool's — the gateway and the terminal's LiteLLM key, Bedrock's models and
# switches, the shared MCP server's token, AWS's: left out of its environment, as claude-sub leaves them out
for v in $(compgen -e); do
  case "$v" in
    ANTHROPIC_* | CLAUDE_CODE_* | CLAUDE_BEDROCK_* | CLAUDE_CONFIG_DIR | SHARED_MCP_TOKEN | BN_MCP_URL | AWS_*) unset "$v" ;;
  esac
done
# BN_SUB_ACCOUNT=NAME (subscriptions open codex:NAME): another account of this tool, its login in a folder of its own,
# ~/.subscriptions/codex/NAME — Codex reads its folder from CODEX_HOME (found in the pinned 0.164.0 program; its login, auth.json, is in it). A name that is not one, or a folder that is not there
# (or is a link, or ~/.subscriptions is), is refused: never a path from outside. Without it, the first account, exactly as before.
if [ -n "${BN_SUB_ACCOUNT:-}" ]; then
  adir="${BN_SUBS_ROOT:-$HOME/.subscriptions}/codex/$BN_SUB_ACCOUNT"
  if ! [[ $BN_SUB_ACCOUNT =~ ^[a-z0-9][a-z0-9-]{0,19}$ ]] || [ ! -d "$adir" ] || [ -L "$adir" ] || [ -L "${adir%/*}" ] || [ -L "${adir%/*/*}" ]; then
    echo "codex: no account called '${BN_SUB_ACCOUNT//[^a-z0-9-]/?}' here (subscriptions accounts codex)" >&2; exit 2
  fi
  export CODEX_HOME="$adir"
fi
# (it names the account for this launcher only: a program the tool runs — Claude Code's Bash running codex — picks its own)
unset BN_SUB_ACCOUNT
# A tmux pane running it is marked as one of your subscriptions' tools (pane option @bn-sub): the Code page's @terminal
# leaves its screen alone, where a sign-in's code may show. A guard against an accidental read, not a boundary.
if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] && [ "${BN_SUB_NOMARK:-0}" != 1 ] && [ -x "${BN_TMUX_BIN:-/usr/bin/tmux}" ]; then
  "${BN_TMUX_BIN:-/usr/bin/tmux}" set-option -p -t "$TMUX_PANE" @bn-sub 1 >/dev/null 2>&1 || true
fi
exec "$bin" --disable daemon_auto_start --disable in_app_updates "$@"
