#!/bin/bash
# devos-claude in the DevOS ADE terminal: Claude Code on AWS Bedrock through this stack's LiteLLM, reached through
# the terminal's gateway on its own network (compose.terminal.yaml sets the environment). The same settings as
# bin/devos-claude on your computer — model mapping, no telemetry, the shared MCP server — plus its launch line
# (price and budget) and a session cost on exit. That cost is the terminal key's spend after the session minus
# before it: LiteLLM's per-session log needs the master key, which never enters this container, so other sessions
# on the same key during this one count too. Plain `claude` here also uses Bedrock (without these extras).
# Claude Code's config here is the container's own ~/.claude (the terminal-home volume), so it starts lean, as
# ~/.claude-bedrock does on your computer: no plugins, hooks or MCP servers from your computer reach this terminal.
set -euo pipefail

die() { printf 'devos-claude: %s\n' "$*" >&2; exit 1; }
gw="${ANTHROPIC_BASE_URL:-}"
key="${ANTHROPIC_AUTH_TOKEN:-}"
mcp="$HOME/.config/bedrock-now/mcp.json"

# usd SPEND -> "$12.40"; 4 decimals below $1, "<$0.0001" for a tiny non-zero spend (as on your computer)
usd() {
  awk -v v="$1" 'BEGIN { if (v > 0 && v < 0.00005) print "<$0.0001"
    else if (v > 0 && sprintf("%.2f", v) + 0 < 1) printf "$%.4f\n", v; else printf "$%.2f\n", v }'
}
# key_info -> LiteLLM /key/info for this key, asked with the key itself (a virtual key may read its own info)
key_info() { curl -fsS -m "${1:-10}" -H "Authorization: Bearer $key" "$gw/key/info" 2>/dev/null; }
key_spend() { key_info "${1:-10}" | jq -er '.info.spend // empty' 2>/dev/null; }
# price_label MODEL -> "$5.00 in / $25.00 out per 1M tokens": what LiteLLM bills for it (its /model/info)
price_label() {
  model_info_json | jq -er --arg m "$1" '
    [.data[] | select(.model_name == $m) | .model_info] | first
    | select(.input_cost_per_token != null and .output_cost_per_token != null)
    | "\(.input_cost_per_token * 1000000) \(.output_cost_per_token * 1000000)"' 2>/dev/null |
    awk 'function money(v,  s) { s = sprintf("%.4f", v); while (s ~ /\.[0-9][0-9][0-9]+$/ && s ~ /0$/) s = substr(s, 1, length(s) - 1); return "$" s }
         NF == 2 && $1 + 0 == 0 && $2 + 0 == 0 { print "free ($0)"; next }
         NF == 2 { printf "%s in / %s out per 1M tokens\n", money($1), money($2) }'
}

# The models Claude Code may run here: LiteLLM's /model/info with the bn_* keys ./stack adds to each chat model
# (lib/code_models.sh: name, vendor, how it works as Claude Code's model, whether Settings › Claude Code › Models lists
# it, the default). model_rows [all] -> id name vendor in out free compat listed default (TAB-separated; prices per 1M
# tokens; the listed ones only without "all"); nothing when LiteLLM does not answer or predates the bn_* keys.
# (fetched once, in this shell: load_model_info; command substitutions below only read it)
info_json=''
load_model_info() { info_json="$(curl -fsS -m 4 -H "Authorization: Bearer $key" "$gw/model/info" 2>/dev/null || true)"; }
model_info_json() { printf '%s' "$info_json"; }
model_rows() {
  # (an alias of the catalog — claude-sonnet-5 — comes with its target's model_info: only the entry bn_id names counts)
  # (names: printable text only — never a control, C1, bidi or line-separator character on the terminal or in /model;
  # ./stack writes a name only when it is plain ASCII, else the id stands in)
  model_info_json | jq -r --arg all "${1:-}" 'def safe: tostring | gsub("[\u0001-\u001f\u007f-\u009f\u200b-\u200f\u2028-\u202e\u2060-\u2069\ufeff\ufffe\uffff]"; "");
    .data[]? | select(.model_info.bn_compat != null) | select((.model_info.bn_id // .model_name) == .model_name)
    | select($all == "all" or .model_info.bn_code == true)
    | [.model_name, ((.model_info.bn_name // .model_name) | safe), ((.model_info.bn_vendor // "-") | safe), (.model_info.input_cost_per_token // "-" | tostring),
       (.model_info.output_cost_per_token // "-" | tostring), (.model_info.bn_compat // "untested"),
       (if .model_info.bn_code == true then 1 else 0 end), (if .model_info.bn_default == true then 1 else 0 end),
       ((.model_info.bn_default_why // "-") | safe)] | @tsv' 2>/dev/null |
    awk -F'\t' -v OFS='\t' 'function m(v,  s) { if (v !~ /^[0-9.eE+-]+$/) return "-"; s = sprintf("%.6f", v * 1000000); sub(/0+$/, "", s); sub(/\.$/, "", s); return s }
      !seen[$1]++ { i = m($4); o = m($5); print $1, $2, $3, i, o, (i == "0" && o == "0" ? 1 : 0), $6, $7, $8, $9 }'
}
# price_word IN OUT FREE -> "$0.72/$0.72 per 1M" or "free ($0)"
price_word() {
  awk -v i="$1" -v o="$2" -v f="$3" 'function m(v,  s) { s = sprintf("%.4f", v); while (s ~ /\.[0-9][0-9][0-9]+$/ && s ~ /0$/) s = substr(s, 1, length(s) - 1); return "$" s }
    BEGIN { if (f == 1) print "free ($0)"; else if (i == "-" || o == "-") print "price unknown"; else printf "%s/%s per 1M\n", m(i), m(o) }'
}
compat_word() { case "$1" in works) echo works ;; chat-only) echo "chat only (no tools)" ;; fails) echo fails ;; *) echo "not tested" ;; esac; }
# default_why WHY -> why the default for new sessions is that model (bn_default_why: lib/code_models.sh code_models_start)
default_why() {
  case "$1" in
    settings) echo "Settings › Claude Code › Default model for new sessions names it" ;;
    sonnet) echo "Settings › Claude Code › Default model for new sessions names no enabled model, so the Sonnet slot" ;;
    main) echo "Settings › Claude Code › Default model for new sessions names no enabled model and no Claude Sonnet is enabled, so the main model" ;;
    first) echo "no default set and neither Claude Sonnet nor the main model enabled, so the first one listed" ;;
    *) echo "Settings › Claude Code › Default model for new sessions (or Claude Sonnet when that names none)" ;;
  esac
}
# resolve_model NAME WHERE -> the id NAME means (id, name, OpenRouter id without or/, opus/sonnet/haiku: that slot),
# [1m] kept; dies naming the choices. Without the list (LiteLLM did not answer) only the aliases are mapped.
resolve_model() {
  local want="$1" base suffix='' id rows
  case "$want" in *'[1m]' | *'[1M]') suffix="${want#"${want%????}"}"; base="${want%????}" ;; *) base="$want" ;; esac
  case "$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')" in
    haiku) base="${ANTHROPIC_DEFAULT_HAIKU_MODEL:-$base}" ;;
    sonnet) base="${ANTHROPIC_DEFAULT_SONNET_MODEL:-$base}" ;;
    opus) base="${ANTHROPIC_DEFAULT_OPUS_MODEL:-$base}" ;;
  esac
  rows="$(model_rows all)"
  [ -n "$rows" ] || { printf '%s%s\n' "$base" "$suffix"; return 0; }
  id="$(printf '%s\n' "$rows" | W="$base" awk -F'\t' 'BEGIN { w = tolower(ENVIRON["W"]) } !f && tolower($1) == w { e = $1; f = 1 }
    !h && (tolower($2) == w || tolower($1) == "or/" w) { h = $1 } END { if (f) print e; else if (h != "") print h }')"
  [ -n "$id" ] || die "unknown model '$want' ($2) — devos-claude --models lists them: $(printf '%s\n' "$rows" | awk -F'\t' '$8 == 1 && n < 6 { printf "%s%s", (n++ ? ", " : ""), $1; next } $8 == 1 { more = 1 } END { if (more) printf ", …" }')"
  printf '%s%s\n' "$id" "$suffix"
}
# picker_json AUTO_OFF -> --settings JSON: Claude Code's /model menu lists the listed models by full id with their names,
# prices and how they work, instead of its own lineup of aliases (at most 150 rows, the default always), plus auto mode
# off; empty without a list
picker_json() {
  model_rows | awk -F'\t' -v off="$1" '
    function js(s) { gsub(/[\001-\037"\\]/, "", s); return "\"" s "\"" }
    function m(v,  s) { s = sprintf("%.4f", v); while (s ~ /\.[0-9][0-9][0-9]+$/ && s ~ /0$/) s = substr(s, 1, length(s) - 1); return "$" s }
    $9 != 1 && n >= 149 && !(had && n < 150) { next }
    $9 == 1 { had = 1 }
    { p = ($6 == 1 ? "free ($0)" : ($4 == "-" || $5 == "-") ? "price unknown" : m($4) "/" m($5) " per 1M")
      c = ($7 == "works" ? "works" : $7 == "chat-only" ? "chat only (no tools)" : $7 == "fails" ? "fails" : "not tested")
      r = r (n++ ? "," : "") "{\"model\":" js($1) ",\"label\":" js($2 (substr($1, 1, 3) == "or/" ? " · OpenRouter" : (substr($1, 1, 3) == "xl/" ? " · Experiential Labs" : ""))) ",\"description\":" js($3 " · " p " · " c) "}" }
    END { if (n) printf "{%s\"modelPicker\":{\"replaceBuiltInOptions\":true,\"options\":[%s]}}\n", (off == 1 ? "\"disableAutoMode\":\"disable\"," : ""), r }'
}

# Settings › Terminal › Auto mode (TERMINAL_AUTO_MODE): Claude Code's auto mode in this terminal's sessions. Its reviewer
# (Claude Code's classifier, CLAUDE_CODE_AUTO_MODE_MODEL) runs on this terminal's Haiku whatever the session's model: a
# safety check, so always a Claude model (as the Code page's sessions: bn-coded.mjs reviewerModel; one of yours wins).
# No Claude Haiku here: Claude Code's default, claude-sonnet-5 (the catalog's alias for Sonnet 5.5).
reviewer='Sonnet 5.5'
case "${ANTHROPIC_DEFAULT_HAIKU_MODEL:-}" in
  claude-haiku-*) export CLAUDE_CODE_AUTO_MODE_MODEL="${CLAUDE_CODE_AUTO_MODE_MODEL:-$ANTHROPIC_DEFAULT_HAIKU_MODEL}"; reviewer="$CLAUDE_CODE_AUTO_MODE_MODEL" ;;
esac
auto_on=0
case "$(printf '%s' "${TERMINAL_AUTO_MODE:-}" | tr '[:upper:]' '[:lower:]')" in true | 1 | yes | on) auto_on=1 ;; esac
if [ "$auto_on" = 1 ]; then auto_help="available (Settings › Terminal › Auto mode): its reviewer model runs on $reviewer"
else auto_help="off (Settings › Terminal › Auto mode turns it on)"; fi

case "${1:-}" in
  --models)
    [ -n "$gw" ] && [ -n "$key" ] || die "this terminal has no LiteLLM settings — run ./stack terminal enable on your computer again"
    load_model_info; rows="$(model_rows "${2:-}")"
    [ -n "$rows" ] || die "LiteLLM at $gw did not list the models (is the stack up, and on this version? ./stack up on your computer)"
    if [ "${2:-}" = all ]; then printf 'Every enabled chat model (* = the default for new sessions):\n'
    else printf 'The models of Settings › Claude Code › Models (* = the default for new sessions; --models all: every enabled one):\n'; fi
    printf '  %-44s %-28s %-20s %s\n' MODEL NAME PRICE "WITH CLAUDE CODE"
    printf '%s\n' "$rows" | while IFS=$'\t' read -r id name vend pin pout free compat _listed def _why; do
      printf '%s %-44s %-28s %-20s %s\n' "$([ "$def" = 1 ] && echo '*' || echo ' ')" "$id" "$(printf '%s' "$name" | cut -c1-28)" \
        "$(price_word "$pin" "$pout" "$free")" "$(compat_word "$compat") · $vend"
    done
    d="$(model_rows all | awk -F'\t' '!f && $9 == 1 { print $1 "\t" $2 "\t" $10; f = 1 }')"
    if [ -n "$d" ]; then
      IFS=$'\t' read -r did dname dwhy <<EOT
$d
EOT
      printf '\n* Default for new sessions: %s (%s): %s.\n' "$dname" "$did" "$(default_why "$dwhy")"
    else printf '\nDefault for new sessions: %s (the Sonnet slot: LiteLLM names no default).\n' "${ANTHROPIC_DEFAULT_SONNET_MODEL:-${CLAUDE_BEDROCK_OPUS_MODEL:-none}}"; fi
    [ -z "${CLAUDE_BEDROCK_MODEL:-}" ] || printf '  CLAUDE_BEDROCK_MODEL=%s in this shell starts devos-claude on that one instead.\n' "$CLAUDE_BEDROCK_MODEL"
    printf '\ndevos-claude --model <id or name> starts on one; /model in a session switches (by full id: an alias lets Claude Code\n'
    printf 'pick the model itself). Only models that "work" can use tools — read, edit and run things.\n'
    exit 0 ;;
  -h | --help)
    cat <<EOT
devos-claude: Claude Code on AWS Bedrock via DevOS ADE, in the browser terminal
  Model    the default of Settings › Claude Code › Default model for new sessions, else Claude Sonnet
           (${ANTHROPIC_DEFAULT_SONNET_MODEL:-${CLAUDE_BEDROCK_OPUS_MODEL:-not set up}}); --model <id or name> or CLAUDE_BEDROCK_MODEL=<name> picks
           another, devos-claude --models lists them and says which applies
  Proxy    LiteLLM through the stack's gateway ($gw), key 'claude-code-terminal' (BUDGET_TERMINAL; Home shows it)
  Files    /workspace is the folder ./stack terminal enable shared; nothing else of your computer is here
  Config   this terminal's own ~/.claude (terminal-home volume), lean: nothing from your computer's ~/.claude
  Auto     auto mode $auto_help
  Quiet    CLAUDE_BEDROCK_QUIET=1 hides the launch line and the session cost on exit
  Below    Claude Code's own help; every option works with devos-claude

EOT
    exec claude "$@" ;;
  -v | --version) exec claude "$@" ;;
esac

[ -n "$gw" ] && [ -n "$key" ] || die "this terminal has no LiteLLM settings — run ./stack terminal enable on your computer again"
curl -fsS -m 3 -o /dev/null "$gw/health/liveliness" 2>/dev/null || die "LiteLLM does not answer at $gw — is the stack up? (./stack status on your computer)"
load_model_info
# The model, by its full id: --model of yours, else CLAUDE_BEDROCK_MODEL, else the default of Settings › Claude Code ›
# Models (bn_default: the one it names while enabled, else the Sonnet slot, else the main model — lib/code_models.sh;
# without one, the Sonnet slot: never Opus by default). Given one of Claude Code's aliases it picks the model itself
# (with "haiku", Plan mode plans on Sonnet): an alias becomes its slot's id, and --model is rewritten to the id (up to a
# `--` of yours).
def="$(model_rows all | awk -F'\t' '!f && $9 == 1 { print $1; f = 1 }')"
model="${CLAUDE_BEDROCK_MODEL:-${def:-${ANTHROPIC_DEFAULT_SONNET_MODEL:-${CLAUDE_BEDROCK_OPUS_MODEL:-}}}}"
[ -n "$model" ] || die "no Claude model is enabled for your AWS key — run ./stack setup on your computer"
where='the default model'; [ -z "${CLAUDE_BEDROCK_MODEL:-}" ] || where=CLAUDE_BEDROCK_MODEL
model="$(resolve_model "$model" "$where")"
cb_args=(); want=''
for a in "$@"; do
  if [ "$want" = next ]; then a="$(resolve_model "$a" --model)"; model="$a"; want=done
  elif [ "$want" != stop ]; then
    case "$a" in
      --) want=stop ;;
      --model) want=next ;;
      --model=*) a="--model=$(resolve_model "${a#--model=}" --model)"; model="${a#--model=}" ;;
    esac
  fi
  cb_args+=("$a")
done
set -- ${cb_args[@]+"${cb_args[@]}"}
export ANTHROPIC_MODEL="$model"
# Claude Code's own background work (titles, summaries, its Explore subagent: its "haiku" model) and its subagents run
# on the session's model when that is not one of Bedrock's Claude models and costs less than Haiku per token (input
# plus output, LiteLLM's prices) — a free one always: a session on a free model never spends on Haiku behind it. A
# dearer one, or one whose price is not known, leaves it on Haiku (as the Code page's sessions: bn-coded.mjs
# followsSession; on your computer, lib/code_models.sh code_bg_follows)
bg_follows() {
  case "$1" in *:free) return 0 ;; esac
  [ -n "${2:-}" ] || return 0
  model_rows all | M="$1" H="$2" awk -F'\t' '
    function num(v) { return v ~ /^[0-9]+(\.[0-9]+)?$/ }
    $1 == ENVIRON["M"] && !sm { sm = 1; mf = $6; if (num($4) && num($5)) { mk = 1; mp = $4 + $5 } }
    $1 == ENVIRON["H"] && !sh { sh = 1; if (num($4) && num($5)) { hk = 1; hp = $4 + $5 } }
    END { if (mf == 1 || (mk && mp == 0)) exit 0; exit !(mk && hk && mp < hp) }'
}
case "$model" in
  claude-*) ;;
  *) if bg_follows "${model%\[1[mM]\]}" "${ANTHROPIC_DEFAULT_HAIKU_MODEL:-}"; then
       export ANTHROPIC_DEFAULT_HAIKU_MODEL="${model%\[1[mM]\]}"
       export ANTHROPIC_SMALL_FAST_MODEL="$ANTHROPIC_DEFAULT_HAIKU_MODEL" CLAUDE_CODE_SUBAGENT_MODEL="$ANTHROPIC_DEFAULT_HAIKU_MODEL"
     fi ;;
esac

before=''
if [ "${CLAUDE_BEDROCK_QUIET:-0}" != 1 ]; then
  via=bedrock; case "$model" in or/*) via=openrouter ;; xl/*) via="experiential labs" ;; esac
  line="$via · $model"
  if p="$(price_label "$model")" && [ -n "$p" ]; then line="$line ($p)"; fi
  case "$(model_rows all | awk -F'\t' -v m="$model" '!f && $1 == m { print $7; f = 1 }')" in
    chat-only) line="$line · chat only: it cannot use tools" ;;
    fails) line="$line · fails as Claude Code's model" ;;
    untested) line="$line · not tested with Claude Code" ;;
  esac
  if info="$(key_info 2)"; then
    before="$(printf '%s' "$info" | jq -er '.info.spend // empty' 2>/dev/null || true)"
    max="$(printf '%s' "$info" | jq -er '.info.max_budget // empty' 2>/dev/null || true)"
    if [ -n "$before" ]; then
      if [ -n "$max" ]; then line="$line · spent $(usd "$before") of $(usd "$max") this period"
        pct="$(awk -v s="$before" -v m="$max" 'BEGIN { if (m > 0 && s >= 0.8 * m) printf "%d", s * 100 / m }')"
        [ -z "$pct" ] || line="$line · ⚠ $pct% of monthly budget used"
      else line="$line · spent $(usd "$before") this period"; fi
    fi
  fi
  printf '%s\n' "$line" >&2
fi

# The shared MCP server, unless the first argument is a Claude Code subcommand (those reject --mcp-config).
subcmds="$(claude --help 2>/dev/null </dev/null | awk '/^Commands:/ { f = 1; next } f && /^[^ ]/ { f = 0 }
  f && /^  [a-z]/ { n = split($1, a, "|"); for (i = 1; i <= n; i++) print a[i] }' || true)"
add_mcp=1
case "${1:-}" in '' | -*) ;; *) for c in $subcmds; do [ "$c" = "$1" ] && { add_mcp=0; break; }; done ;; esac
mcp_args=()
# First, as one argument: after yours a `--` would make it prompt text; as two, the variadic option takes your prompt.
[ "$add_mcp" = 1 ] && [ -f "$mcp" ] && mcp_args=("--mcp-config=$mcp")
# Claude Code's flag tier for a session (a --settings of your own replaces it): its /model menu lists the models of
# Settings › Claude Code › Models by full id, name, price and how they work (picker_json), and auto mode is off unless
# Settings › Terminal › Auto mode is on (TERMINAL_AUTO_MODE), as devos-claude on your computer does. The sandbox's
# managed settings already turn auto mode off unless one of the two switches is on; this covers the Code page's alone.
if [ "$add_mcp" = 1 ]; then
  off=1; [ "$auto_on" != 1 ] || off=0
  pj="$(picker_json "$off")"
  if [ -n "$pj" ]; then mcp_args+=("--settings=$pj")
  elif [ "$off" = 1 ]; then mcp_args+=('--settings={"disableAutoMode":"disable"}'); fi
fi

# Every request carries a session id and tags (LiteLLM UI › Logs can filter by them); your own headers are kept.
sid="cb-$(date -u +%Y%m%dT%H%M%S)-$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')"
ANTHROPIC_CUSTOM_HEADERS="${ANTHROPIC_CUSTOM_HEADERS:+$ANTHROPIC_CUSTOM_HEADERS
}x-litellm-session-id: $sid
x-litellm-tags: claude-bedrock,terminal"
export ANTHROPIC_CUSTOM_HEADERS

want_summary=0
if [ "$add_mcp" = 1 ] && [ "${CLAUDE_BEDROCK_QUIET:-0}" != 1 ] && [ -n "$before" ]; then
  if [ -t 2 ] || [ "${CLAUDE_BEDROCK_SUMMARY:-0}" = 1 ]; then want_summary=1; fi
fi
[ "$want_summary" = 1 ] || exec claude ${mcp_args[@]+"${mcp_args[@]}"} "$@"

# claude runs as a foreground child (Ctrl-C reaches it directly); the ':' traps only keep this script alive.
trap ':' INT QUIT TERM
trap 'exit 129' HUP
if claude ${mcp_args[@]+"${mcp_args[@]}"} "$@"; then rc=0; else rc=$?; fi
trap 'exit "$rc"' INT QUIT TERM HUP
# LiteLLM books spend in batches (within ~1-6 s): wait up to 8 s for it to move.
[ ! -t 2 ] || printf 'session: tallying cost…' >&2
after=''
for _ in 1 2 3 4 5 6 7 8 9; do
  after="$(key_spend 3 || true)"
  if [ -n "$after" ] && awk -v a="$after" -v b="$before" 'BEGIN { exit !(a > b) }'; then break; fi
  sleep 1
done
if [ -z "$after" ]; then msg="session cost: unknown (LiteLLM did not answer) — Home shows the key's spend"
elif awk -v a="$after" -v b="$before" 'BEGIN { exit !(a > b) }'; then
  msg="session: $(usd "$(awk -v a="$after" -v b="$before" 'BEGIN { printf "%.10f", a - b }')") (terminal key: $(usd "$after") this period)"
else msg="session: no spend booked yet — Home shows the key's spend"; fi
if [ -t 2 ]; then printf '\r\033[K%s\n' "$msg" >&2; else printf '%s\n' "$msg" >&2; fi
exit "$rc"
