#!/bin/bash
# cursor-agent in the DevOS ADE sandbox: Cursor's CLI as Cursor ships it (/usr/local/lib/bn-tools/cursor, the package
# its own installer downloads, pinned by version and the SHA-256 seen on 2026-10-23 — Cursor publishes no checksum;
# terminal/Dockerfile's ai-tools stage). On your Cursor plan: `cursor-agent login` prints a link to open in your
# browser and waits for it (NO_OPEN_BROWSER=1: no browser can open in the sandbox); `cursor-agent status`,
# `cursor-agent logout`. It keeps the login in ~/.config/cursor (its own file, which DevOS ADE never opens). Its
# self-update stays off (--disable-auto-update): the image pins its version.
set -euo pipefail
bin="${BN_TOOLS_DIR:-/usr/local/lib/bn-tools}/cursor/cursor-agent"
[ -x "$bin" ] || { echo "cursor-agent: not in this sandbox (left out by TERMINAL_AI_TOOLS in .env — Settings › Claude Code › More — or its download failed when the image was built: ${BN_TOOLS_DIR:-/usr/local/lib/bn-tools}/SKIPPED)" >&2; exit 127; }
umask 077
# The stack's own variables are not this tool's — the gateway and the terminal's LiteLLM key, Bedrock's models and
# switches, the shared MCP server's token, AWS's: left out of its environment, as claude-sub leaves them out
for v in $(compgen -e); do
  case "$v" in
    ANTHROPIC_* | CLAUDE_CODE_* | CLAUDE_BEDROCK_* | CLAUDE_CONFIG_DIR | SHARED_MCP_TOKEN | BN_MCP_URL | AWS_*) unset "$v" ;;
  esac
done
# BN_SUB_ACCOUNT=NAME (subscriptions open cursor:NAME): another account of this tool, its login in a folder of its own,
# ~/.subscriptions/cursor/NAME — Cursor CLI keeps auth.json in $XDG_CONFIG_HOME/cursor on Linux (CURSOR_CONFIG_DIR moves its settings, not the login), so the account's folder is its XDG_CONFIG_HOME (the pinned 2026.10.22 package). A name that is not one, or a folder that is not there
# (or is a link, or ~/.subscriptions is), is refused: never a path from outside. Without it, the first account, exactly as before.
if [ -n "${BN_SUB_ACCOUNT:-}" ]; then
  adir="${BN_SUBS_ROOT:-$HOME/.subscriptions}/cursor/$BN_SUB_ACCOUNT"
  if ! [[ $BN_SUB_ACCOUNT =~ ^[a-z0-9][a-z0-9-]{0,19}$ ]] || [ ! -d "$adir" ] || [ -L "$adir" ] || [ -L "${adir%/*}" ] || [ -L "${adir%/*/*}" ]; then
    echo "cursor-agent: no account called '${BN_SUB_ACCOUNT//[^a-z0-9-]/?}' here (subscriptions accounts cursor)" >&2; exit 2
  fi
  # Moving XDG_CONFIG_HOME would take the sandbox's other config with it — gh's and glab's logins, git's identity — so those
  # stay where they were: gh and glab pinned to the old folder, git's file included by environment (command scope: it
  # outranks ~/.gitconfig, as the identity in ~/.config/git/config already does for everything else; any other tool the session runs
  # reads the account's folder as its XDG_CONFIG_HOME: accepted)
  old="${XDG_CONFIG_HOME:-$HOME/.config}"
  [ -n "${GH_CONFIG_DIR:-}" ] || export GH_CONFIG_DIR="$old/gh"
  [ -n "${GLAB_CONFIG_DIR:-}" ] || export GLAB_CONFIG_DIR="$old/glab-cli"
  if [ -f "$old/git/config" ]; then
    n="${GIT_CONFIG_COUNT:-0}"; [[ $n =~ ^[0-9]{1,3}$ ]] || n=0
    export "GIT_CONFIG_KEY_$n=include.path" "GIT_CONFIG_VALUE_$n=$old/git/config" GIT_CONFIG_COUNT=$((n + 1))
  fi
  export XDG_CONFIG_HOME="$adir"
fi
# (it names the account for this launcher only: a program the tool runs — Claude Code's Bash running codex — picks its own)
unset BN_SUB_ACCOUNT
# A tmux pane running it is marked as one of your subscriptions' tools (pane option @bn-sub): the Code page's @terminal
# leaves its screen alone, where a sign-in's code may show. A guard against an accidental read, not a boundary.
if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] && [ "${BN_SUB_NOMARK:-0}" != 1 ] && [ -x "${BN_TMUX_BIN:-/usr/bin/tmux}" ]; then
  "${BN_TMUX_BIN:-/usr/bin/tmux}" set-option -p -t "$TMUX_PANE" @bn-sub 1 >/dev/null 2>&1 || true
fi
export NO_OPEN_BROWSER=1
# no compiled-code cache in the writable home (Cursor's script would keep one in ~/.cache, and Node would run from it)
export NODE_DISABLE_COMPILE_CACHE=1
exec "$bin" --disable-auto-update "$@"
